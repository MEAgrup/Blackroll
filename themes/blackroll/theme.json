{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"customGradient": true,
			"palette": [
				{ "slug": "black", "color": "#0A0A0A", "name": "Brand Black" },
				{ "slug": "white", "color": "#FFFFFF", "name": "Brand White" },
				{ "slug": "charcoal", "color": "#1A1A1A", "name": "Charcoal" },
				{ "slug": "grey", "color": "#8A8A8A", "name": "Grey (large/decorative only)" },
				{ "slug": "grey-text", "color": "#6B6B6B", "name": "Grey Text (AA on white)" },
				{ "slug": "hairline", "color": "#E6E6E6", "name": "Hairline" }
			],
			"gradients": [
				{
					"slug": "black-fade",
					"gradient": "linear-gradient(180deg, #0A0A0A 0%, #1A1A1A 100%)",
					"name": "Black Fade"
				}
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"customFontSize": true,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Anton (Headings)",
					"fontFamily": "\"Anton\", Impact, \"Arial Narrow\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Anton",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/anton-latin-400.woff2" ]
						}
					]
				},
				{
					"slug": "body",
					"name": "Inter (Body)",
					"fontFamily": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter-latin-var.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "X-Large", "size": "2rem", "fluid": { "min": "1.75rem", "max": "2.25rem" } },
				{ "slug": "xx-large", "name": "2X-Large", "size": "3rem", "fluid": { "min": "2.25rem", "max": "3.5rem" } },
				{ "slug": "display", "name": "Display", "size": "4.5rem", "fluid": { "min": "2.75rem", "max": "5rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"customSpacingSize": true,
			"units": [ "px", "em", "rem", "vw", "vh", "%" ],
			"spacingSizes": [
				{ "slug": "20", "name": "1 — X-Small", "size": "clamp(0.75rem, 2vw, 1rem)" },
				{ "slug": "30", "name": "2 — Small", "size": "clamp(1rem, 3vw, 1.5rem)" },
				{ "slug": "40", "name": "3 — Medium", "size": "clamp(1.5rem, 4vw, 2.5rem)" },
				{ "slug": "50", "name": "4 — Large", "size": "clamp(2.5rem, 6vw, 4rem)" },
				{ "slug": "60", "name": "5 — X-Large", "size": "clamp(4rem, 9vw, 6.5rem)" },
				{ "slug": "70", "name": "6 — Huge", "size": "clamp(6rem, 12vw, 9rem)" }
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"dimensions": {
			"minHeight": true
		},
		"custom": {
			"cta": {
				"floating": {
					"size": "56px",
					"offset": "clamp(1rem, 4vw, 2rem)"
				}
			},
			"transition": {
				"base": "180ms cubic-bezier(0.4, 0, 0.2, 1)"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--black)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65",
			"fontWeight": "400"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "clamp(1rem, 5vw, 2rem)",
				"right": "clamp(1rem, 5vw, 2rem)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "400",
					"textTransform": "uppercase",
					"lineHeight": "1.02",
					"letterSpacing": "0.01em"
				}
			},
			"h1": {
				"typography": { "fontSize": "var(--wp--preset--font-size--display)" }
			},
			"h2": {
				"typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" }
			},
			"h3": {
				"typography": { "fontSize": "var(--wp--preset--font-size--x-large)" }
			},
			"h4": {
				"typography": { "fontSize": "var(--wp--preset--font-size--large)", "textTransform": "uppercase" }
			},
			"h5": {
				"typography": { "fontSize": "var(--wp--preset--font-size--medium)" }
			},
			"h6": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "letterSpacing": "0.08em" }
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--black)" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"typography": { "textDecoration": "none" }
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--black)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": { "radius": "0px" },
				"spacing": {
					"padding": {
						"top": "0.9rem",
						"bottom": "0.9rem",
						"left": "1.75rem",
						"right": "1.75rem"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"textTransform": "uppercase",
					"letterSpacing": "0.06em"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--charcoal)",
						"text": "var(--wp--preset--color--white)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--charcoal)",
						"text": "var(--wp--preset--color--white)"
					}
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--grey-text)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "400",
					"textTransform": "uppercase",
					"letterSpacing": "0.02em"
				}
			},
			"core/post-title": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)" }
			},
			"core/pullquote": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-no-title", "title": "Page — No Title", "postTypes": [ "page" ] },
		{ "name": "template-product", "title": "Product Page", "postTypes": [ "page" ] },
		{ "name": "template-thankyou", "title": "Thank You (noindex)", "postTypes": [ "page" ] }
	]
}
